<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/gl_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/w_text"
            android:textSize="15sp"
            android:text="진행 중인 목표" />
        <TextView
            android:id="@+id/gl_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/brand"
            android:textSize="14sp"
            android:text="" />
    </LinearLayout>
    <TextView
        android:id="@+id/gl_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/w_sub"
        android:textSize="14sp"
        android:text="연간·월간 목표를 세워보세요"
        android:layout_marginTop="10dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/gl_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/gl_txt1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/w_text"
                android:textSize="13sp"
                android:text="목표" />
            <TextView
                android:id="@+id/gl_pct1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:text="40%" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/gl_bar1"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/gl_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/gl_txt2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/w_text"
                android:textSize="13sp"
                android:text="목표" />
            <TextView
                android:id="@+id/gl_pct2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:text="40%" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/gl_bar2"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/gl_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/gl_txt3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/w_text"
                android:textSize="13sp"
                android:text="목표" />
            <TextView
                android:id="@+id/gl_pct3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/brand"
                android:textSize="13sp"
                android:text="40%" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/gl_bar3"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</LinearLayout>
