<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/ov_card_bg"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/ov_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/brand"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/pretendard_bold"
            android:text="아직 집중하는 중이에요"
            android:textColor="@color/ov_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/ov_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/pretendard_regular"
            android:lineSpacingExtra="3dp"
            android:text="다른 앱을 계속 쓰면 타이머가 멈춰요."
            android:textColor="@color/ov_sub"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ov_back"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/ov_btn_primary"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:text="공부로 돌아가기"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/ov_ignore"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/ov_btn_secondary"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:text="무시하고 계속하기"
            android:textColor="@color/ov_sub"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
