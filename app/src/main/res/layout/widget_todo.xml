<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/todo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/w_text"
            android:textSize="15sp"
            android:text="오늘 할 일" />
        <TextView
            android:id="@+id/todo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/brand"
            android:textSize="14sp"
            android:text="2/5" />
    </LinearLayout>
    <TextView
        android:id="@+id/todo_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/w_sub"
        android:textSize="14sp"
        android:text="오늘 할 일을 추가해보세요"
        android:layout_marginTop="10dp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/todo_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/todo_chk1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/brand"
            android:textSize="18sp"
            android:text="○" />
        <TextView
            android:id="@+id/todo_txt1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/w_text"
            android:textSize="14sp"
            android:text="할 일" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/todo_row2"
