<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/tm_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/w_sub"
        android:textSize="12sp"
        android:text="자유 공부" />
    <Chronometer
        android:id="@+id/tm_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="@color/w_text"
        android:textSize="30sp" />
    <TextView
        android:id="@+id/tm_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/pretendard_semibold"
        android:textColor="@color/brand"
        android:textSize="12sp"
        android:text="시작해볼까요?" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tm_toggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/ov_btn_primary"
            android:gravity="center"
            android:fontFamily="@font/pretendard_semibold"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:text="시작" />
        <TextView
            android:id="@+id/tm_stop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/ov_btn_secondary"
            android:gravity="center"
            android:fontFamily="@font/pretendard_semibold"
            android:textColor="@color/ov_sub"
            android:textSize="14sp"
            android:text="종료" />
    </LinearLayout>
</LinearLayout>
